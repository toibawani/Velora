{
  "name": "velora",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lucide-react": "^1.45.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-scripts": "^5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "typecheck": "tsc --noEmit",
    "test": "react-scripts test",
    "lint": "eslint --max-warnings=0 --ext .js,.jsx,.ts,.tsx src --ignore-pattern '*.test.js' --ignore-pattern '*.test.jsx' --ignore-pattern '*.test.ts' --ignore-pattern '*.test.tsx'",
    "lint:all": "eslint --max-warnings=0 --ext .js,.jsx,.ts,.tsx src",
    "eject": "react-scripts eject",
    "test:layout": "node scripts/layoutCheck.js",
    "test:a11y": "node scripts/atlasAccessibilityAudit.js",
    "test:naming": "node scripts/nameAudit.js",
    "test:games": "node scripts/gameAudit.js",
    "test:atlas-topics": "node scripts/atlasTopicVerify.js",
    "test:atlas-tap": "node scripts/atlasTapAudit.js",
    "test:levels": "node scripts/levelsVerify.js"
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "statements": 67,
        "branches": 61,
        "functions": 60,
        "lines": 68
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/jest": "^27.5.2",
    "jest-axe": "^11.0.0",
    "puppeteer-core": "^23.11.1"
  }
}
