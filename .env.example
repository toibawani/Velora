# ==============================================================================
# VELORA Environment Configuration Template (.env.example)
# ==============================================================================
# SECURITY RULES:
# 1. Store ALL sensitive credentials exclusively in an isolated backend .env file.
# 2. Public frontend variables MUST contain ONLY public keys (e.g. REACT_APP_PUBLIC_API_URL).
# 3. NEVER hardcode secret keys, service role tokens, or private credentials in any file.
# 4. NEVER prefix master database keys or secret API keys with VITE_, NEXT_PUBLIC_, or REACT_APP_.
# ==============================================================================

# Server & Runtime Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (Isolated server-side only - NEVER expose to client)
DATABASE_URL=postgresql://velora_admin:change_me_in_production@localhost:5432/velora_db
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Authentication & Encryption (Secret keys - isolated backend only)
JWT_SECRET=super_secret_jwt_hmac_sha256_key_min_32_chars
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY_AES256=change_this_to_a_32_byte_secure_hex_key

# Strict CORS Security Policy (Whitelisted origins only)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://velora.app

# Content & Intelligence Integration Keys (Private server-side API keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Public Frontend Variables (ONLY public/non-sensitive values may use REACT_APP_)
REACT_APP_API_BASE_URL=http://localhost:4000
REACT_APP_BUILD_ENV=development
